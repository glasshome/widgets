{
  "name": "@glasshome/widgets",
  "version": "0.3.6",
  "private": true,
  "description": "Reference implementation of built-in GlassHome dashboard widgets",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/glasshome/widgets.git"
  },
  "type": "module",
  "exports": {
    "./tailwind-sources": "./tailwind-sources.css"
  },
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "test": "bun test src && vitest run",
    "test:dom": "vitest run",
    "dev": "bun ../widget-cli/bin/cli.ts connect http://localhost:3123",
    "check:dead": "fallow dead-code --fail-on-issues",
    "lint": "oxlint --type-aware . && oxfmt --check ."
  },
  "dependencies": {
    "@iconify-icon/solid": "^3.0.3"
  },
  "devDependencies": {
    "@glasshome/widget-sdk": "1.31.1",
    "@solidjs/testing-library": "^0.8.10",
    "@types/bun": "^1.4.0",
    "fallow": "3.17.0",
    "happy-dom": "^20.0.0",
    "oxfmt": "0.65.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "^7.0.2",
    "vite": "^8.1.0",
    "vite-plugin-solid": "^2.11.12",
    "vitest": "4.1.11"
  },
  "peerDependencies": {
    "@glasshome/ui": "1.37.0",
    "@glasshome/widget-sdk": "1.31.1",
    "solid-js": "^1.9.11"
  }
}
