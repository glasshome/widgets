{
  "name": "Climate",
  "description": "Climate control with temperature, HVAC modes, and fan control",
  "icon": "mdi:thermostat",
  "minSize": {
    "w": 1,
    "h": 1
  },
  "maxSize": {
    "w": 8,
    "h": 8
  },
  "sdkVersion": "^1.17.0",
  "version": "0.8.1",
  "defaultSize": {
    "w": 2,
    "h": 2
  },
  "capabilities": [
    {
      "domain": "climate",
      "access": "control"
    }
  ],
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "title": {
        "title": "Title",
        "description": "Optional display name override",
        "type": "string"
      },
      "entityIds": {
        "default": [],
        "domain": "climate",
        "title": "Entity",
        "singleSelect": true,
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "art": {
        "default": "thermostat",
        "title": "Device picture",
        "labels": {
          "thermostat": "Thermostat",
          "radiator": "Radiator",
          "ac": "Air conditioner",
          "heatpump": "Heat pump"
        },
        "icons": {
          "thermostat": "mdi:thermostat",
          "radiator": "mdi:radiator",
          "ac": "mdi:air-conditioner",
          "heatpump": "mdi:heat-pump-outline"
        },
        "type": "string",
        "enum": [
          "thermostat",
          "radiator",
          "ac",
          "heatpump"
        ]
      }
    },
    "required": [
      "entityIds",
      "art"
    ],
    "additionalProperties": false
  },
  "defaultConfig": {
    "entityIds": [],
    "art": "thermostat"
  },
  "examples": [
    {
      "label": "Thermostat",
      "size": {
        "w": 2,
        "h": 2
      },
      "config": {
        "entityIds": [
          "climate.living_room_thermostat"
        ],
        "title": "Thermostat",
        "art": "thermostat"
      }
    },
    {
      "label": "Radiator heating",
      "size": {
        "w": 3,
        "h": 2
      },
      "config": {
        "entityIds": [
          "climate.living_room_thermostat"
        ],
        "title": "Living Room",
        "art": "radiator"
      }
    },
    {
      "label": "Air conditioner off",
      "size": {
        "w": 2,
        "h": 2
      },
      "config": {
        "entityIds": [
          "climate.bedroom_ac"
        ],
        "title": "Bedroom",
        "art": "ac"
      }
    },
    {
      "label": "Heat pump",
      "size": {
        "w": 4,
        "h": 3
      },
      "config": {
        "entityIds": [
          "climate.living_room_thermostat"
        ],
        "title": "Heat Pump",
        "art": "heatpump"
      }
    },
    {
      "label": "Compact",
      "size": {
        "w": 2,
        "h": 1
      },
      "config": {
        "entityIds": [
          "climate.living_room_thermostat"
        ],
        "title": "Thermostat",
        "art": "thermostat"
      }
    },
    {
      "label": "Air conditioner, wide",
      "size": {
        "w": 4,
        "h": 2
      },
      "config": {
        "entityIds": [
          "climate.bedroom_ac"
        ],
        "title": "Bedroom",
        "art": "ac"
      }
    },
    {
      "label": "Large thermostat",
      "size": {
        "w": 6,
        "h": 6
      },
      "config": {
        "entityIds": [
          "climate.living_room_thermostat"
        ],
        "title": "Thermostat",
        "art": "thermostat"
      }
    }
  ],
  "configVersion": 2
}
