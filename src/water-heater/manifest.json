{
  "name": "Water Heater",
  "description": "Water heater control with target temperature and operation modes",
  "icon": "mdi:water-boiler",
  "minSize": {
    "w": 1,
    "h": 1
  },
  "maxSize": {
    "w": 4,
    "h": 4
  },
  "sdkVersion": "^1.4.0",
  "version": "0.1.0",
  "defaultSize": {
    "w": 2,
    "h": 2
  },
  "capabilities": [
    {
      "domain": "water_heater",
      "access": "control"
    }
  ],
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "title": {
        "title": "Title",
        "description": "Optional display name override",
        "type": "string"
      },
      "entityIds": {
        "default": [],
        "domain": "water_heater",
        "title": "Entities",
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "required": [
      "entityIds"
    ],
    "additionalProperties": false
  },
  "defaultConfig": {
    "entityIds": []
  },
  "examples": [
    {
      "label": "Eco",
      "size": {
        "w": 2,
        "h": 2
      },
      "config": {
        "entityIds": [
          "water_heater.boiler"
        ],
        "title": "Boiler"
      }
    },
    {
      "label": "Heat pump",
      "size": {
        "w": 2,
        "h": 2
      },
      "config": {
        "entityIds": [
          "water_heater.heat_pump_tank"
        ]
      }
    }
  ]
}
