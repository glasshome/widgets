{
  "name": "Binary Sensor",
  "description": "Motion, door, occupancy sensors",
  "icon": "mdi:checkbox-marked-circle",
  "minSize": {
    "w": 1,
    "h": 1
  },
  "maxSize": {
    "w": 4,
    "h": 4
  },
  "sdkVersion": "^1.9.0",
  "version": "0.6.3",
  "defaultSize": {
    "w": 1,
    "h": 1
  },
  "capabilities": [
    {
      "domain": "binary_sensor",
      "access": "read"
    }
  ],
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "title": {
        "title": "Title",
        "description": "Optional display name override",
        "type": "string"
      },
      "entityIds": {
        "default": [],
        "domain": "binary_sensor",
        "title": "Entities",
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "required": [
      "entityIds"
    ],
    "additionalProperties": false
  },
  "defaultConfig": {
    "entityIds": []
  },
  "examples": [
    {
      "label": "Contact & Motion",
      "size": {
        "w": 2,
        "h": 2
      },
      "config": {
        "entityIds": [
          "binary_sensor.front_door",
          "binary_sensor.motion_hallway",
          "binary_sensor.window_bedroom"
        ],
        "title": "Front Door"
      }
    }
  ]
}
