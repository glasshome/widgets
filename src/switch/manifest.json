{
  "name": "Switch",
  "description": "Toggle switch entities",
  "icon": "mdi:power-plug",
  "minSize": {
    "w": 1,
    "h": 1
  },
  "maxSize": {
    "w": 4,
    "h": 4
  },
  "sdkVersion": "^1.11.2",
  "version": "0.7.0",
  "defaultSize": {
    "w": 1,
    "h": 1
  },
  "capabilities": [
    {
      "domain": "switch",
      "access": "control"
    }
  ],
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "title": {
        "title": "Title",
        "description": "Optional display name override",
        "type": "string"
      },
      "entityIds": {
        "default": [],
        "domain": "switch",
        "title": "Entities",
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "required": [
      "entityIds"
    ],
    "additionalProperties": false
  },
  "defaultConfig": {
    "entityIds": []
  },
  "examples": [
    {
      "label": "Switches",
      "size": {
        "w": 2,
        "h": 2
      },
      "config": {
        "entityIds": [
          "switch.coffee_machine",
          "switch.fan_living_room"
        ],
        "title": "Switches"
      }
    }
  ]
}
