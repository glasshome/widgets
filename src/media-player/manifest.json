{
  "name": "Media Player",
  "description": "Media playback controls with album art and progress tracking",
  "icon": "mdi:music",
  "minSize": {
    "w": 2,
    "h": 1
  },
  "maxSize": {
    "w": 4,
    "h": 4
  },
  "sdkVersion": "^1.11.1",
  "version": "0.8.0",
  "defaultSize": {
    "w": 3,
    "h": 2
  },
  "capabilities": [
    {
      "domain": "media_player",
      "access": "control"
    }
  ],
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "title": {
        "title": "Title",
        "description": "Optional display name override",
        "type": "string"
      },
      "entityIds": {
        "default": [],
        "domain": "media_player",
        "title": "Entity",
        "singleSelect": true,
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "required": [
      "entityIds"
    ],
    "additionalProperties": false
  },
  "defaultConfig": {
    "entityIds": []
  },
  "examples": [
    {
      "label": "Living Room",
      "size": {
        "w": 4,
        "h": 2
      },
      "config": {
        "entityIds": [
          "media_player.living_room_speaker"
        ],
        "title": "Living Room"
      }
    }
  ]
}
