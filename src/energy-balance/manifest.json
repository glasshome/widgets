{
  "name": "Energy Balance",
  "description": "Today's self-sufficiency: how much of your home ran on solar vs the grid",
  "icon": "mdi:solar-power",
  "minSize": {
    "w": 2,
    "h": 2
  },
  "maxSize": {
    "w": 3,
    "h": 3
  },
  "sdkVersion": "^1.9.1",
  "version": "0.2.0",
  "defaultSize": {
    "w": 2,
    "h": 2
  },
  "capabilities": [
    {
      "domain": "sensor",
      "access": "read"
    }
  ],
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "title": {
        "title": "Title",
        "description": "Optional display name override",
        "type": "string"
      },
      "solarEnergyEntity": {
        "default": [],
        "domain": "sensor",
        "title": "Solar produced",
        "description": "Daily solar production energy sensor (kWh). Optional. Leave empty if you have no solar.",
        "deviceClass": "energy",
        "singleSelect": true,
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "gridImportEnergyEntity": {
        "default": [],
        "domain": "sensor",
        "title": "Grid imported",
        "description": "Daily energy drawn from the grid (kWh). The main input, and enough on its own.",
        "deviceClass": "energy",
        "singleSelect": true,
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "gridExportEnergyEntity": {
        "default": [],
        "domain": "sensor",
        "title": "Grid exported",
        "description": "Daily energy sent to the grid (kWh). Optional.",
        "deviceClass": "energy",
        "singleSelect": true,
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "batteryChargeEnergyEntity": {
        "default": [],
        "domain": "sensor",
        "title": "Battery charged",
        "description": "Daily energy stored into the battery (kWh). Optional.",
        "deviceClass": "energy",
        "singleSelect": true,
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "batteryDischargeEnergyEntity": {
        "default": [],
        "domain": "sensor",
        "title": "Battery discharged",
        "description": "Daily energy drawn from the battery (kWh). Optional.",
        "deviceClass": "energy",
        "singleSelect": true,
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "homeEnergyEntity": {
        "default": [],
        "domain": "sensor",
        "title": "Home consumed",
        "description": "Daily total home consumption (kWh). Optional. Overrides the derived value when set.",
        "deviceClass": "energy",
        "singleSelect": true,
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "gridImportPowerEntity": {
        "default": [],
        "domain": "sensor",
        "title": "Grid import (live)",
        "description": "Live power drawn from the grid (W). Optional. Leave empty if your grid sensor is signed.",
        "deviceClass": "power",
        "singleSelect": true,
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "gridExportPowerEntity": {
        "default": [],
        "domain": "sensor",
        "title": "Grid export (live)",
        "description": "Live power sent to the grid (W). Optional.",
        "deviceClass": "power",
        "singleSelect": true,
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "gridSignedPowerEntity": {
        "default": [],
        "domain": "sensor",
        "title": "Grid live (signed)",
        "description": "Single live grid sensor where positive = import, negative = export. Use instead of the two above.",
        "deviceClass": "power",
        "singleSelect": true,
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "solarPowerEntity": {
        "default": [],
        "domain": "sensor",
        "title": "Solar power (live)",
        "description": "Live solar production power (W). Enables the Live mode (tap the widget to cycle).",
        "deviceClass": "power",
        "singleSelect": true,
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "homePowerEntity": {
        "default": [],
        "domain": "sensor",
        "title": "Home power (live)",
        "description": "Live home consumption power (W). Enables the Live mode.",
        "deviceClass": "power",
        "singleSelect": true,
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "required": [
      "solarEnergyEntity",
      "gridImportEnergyEntity",
      "gridExportEnergyEntity",
      "batteryChargeEnergyEntity",
      "batteryDischargeEnergyEntity",
      "homeEnergyEntity",
      "gridImportPowerEntity",
      "gridExportPowerEntity",
      "gridSignedPowerEntity",
      "solarPowerEntity",
      "homePowerEntity"
    ],
    "additionalProperties": false
  },
  "defaultConfig": {
    "solarEnergyEntity": [],
    "gridImportEnergyEntity": [],
    "gridExportEnergyEntity": [],
    "batteryChargeEnergyEntity": [],
    "batteryDischargeEnergyEntity": [],
    "homeEnergyEntity": [],
    "gridImportPowerEntity": [],
    "gridExportPowerEntity": [],
    "gridSignedPowerEntity": [],
    "solarPowerEntity": [],
    "homePowerEntity": []
  },
  "examples": [
    {
      "label": "Solar and battery",
      "size": {
        "w": 3,
        "h": 3
      },
      "config": {
        "title": "Energy Balance",
        "solarEnergyEntity": [
          "sensor.solar_power"
        ],
        "gridImportEnergyEntity": [
          "sensor.grid_import_power"
        ],
        "gridExportEnergyEntity": [
          "sensor.grid_export_power"
        ],
        "batteryChargeEnergyEntity": [
          "sensor.battery_charge_power"
        ],
        "batteryDischargeEnergyEntity": [
          "sensor.battery_discharge_power"
        ],
        "homeEnergyEntity": [],
        "gridImportPowerEntity": [
          "sensor.grid_import_power"
        ],
        "gridExportPowerEntity": [
          "sensor.grid_export_power"
        ],
        "gridSignedPowerEntity": [],
        "solarPowerEntity": [
          "sensor.solar_power"
        ],
        "homePowerEntity": [
          "sensor.home_power"
        ]
      }
    },
    {
      "label": "Grid only",
      "size": {
        "w": 2,
        "h": 2
      },
      "config": {
        "title": "Electricity",
        "solarEnergyEntity": [],
        "gridImportEnergyEntity": [
          "sensor.grid_import_power"
        ],
        "gridExportEnergyEntity": [],
        "batteryChargeEnergyEntity": [],
        "batteryDischargeEnergyEntity": [],
        "homeEnergyEntity": [
          "sensor.home_power"
        ],
        "gridImportPowerEntity": [
          "sensor.grid_import_power"
        ],
        "gridExportPowerEntity": [],
        "gridSignedPowerEntity": [],
        "solarPowerEntity": [],
        "homePowerEntity": [
          "sensor.home_power"
        ]
      }
    }
  ]
}
