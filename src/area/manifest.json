{
  "name": "Area",
  "description": "Area overview with entity grouping and batch controls",
  "icon": "mdi:home-floor-1",
  "minSize": {
    "w": 2,
    "h": 2
  },
  "maxSize": {
    "w": 4,
    "h": 6
  },
  "sdkVersion": "^1.10.1",
  "version": "0.8.0",
  "defaultSize": {
    "w": 3,
    "h": 3
  },
  "capabilities": [
    {
      "domain": "light",
      "access": "control"
    },
    {
      "domain": "switch",
      "access": "control"
    },
    {
      "domain": "cover",
      "access": "control"
    },
    {
      "domain": "climate",
      "access": "read"
    },
    {
      "domain": "sensor",
      "access": "read"
    },
    {
      "domain": "binary_sensor",
      "access": "read"
    }
  ],
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "title": {
        "title": "Title",
        "description": "Optional display name override",
        "type": "string"
      },
      "areaId": {
        "formType": "area-picker",
        "title": "Area",
        "type": "string"
      }
    },
    "additionalProperties": false
  },
  "defaultConfig": {},
  "examples": [
    {
      "label": "Living Room",
      "size": {
        "w": 3,
        "h": 3
      },
      "config": {
        "areaId": "living_room",
        "title": "Living Room"
      }
    }
  ]
}
