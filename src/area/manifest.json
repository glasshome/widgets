{
  "name": "Area",
  "description": "Area overview with entity grouping and batch controls",
  "icon": "mdi:home-floor-1",
  "minSize": {
    "w": 2,
    "h": 2
  },
  "maxSize": {
    "w": 4,
    "h": 6
  },
  "sdkVersion": "^1.16.0",
  "version": "0.8.2",
  "defaultSize": {
    "w": 3,
    "h": 3
  },
  "capabilities": [
    {
      "domain": "light",
      "access": "control"
    },
    {
      "domain": "switch",
      "access": "control"
    },
    {
      "domain": "cover",
      "access": "control"
    },
    {
      "domain": "climate",
      "access": "read"
    },
    {
      "domain": "sensor",
      "access": "read"
    },
    {
      "domain": "binary_sensor",
      "access": "read"
    },
    {
      "domain": "sun",
      "access": "read"
    }
  ],
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "title": {
        "title": "Title",
        "description": "Optional display name override",
        "type": "string"
      },
      "areaId": {
        "formType": "area-picker",
        "title": "Area",
        "type": "string"
      },
      "image": {
        "type": "string",
        "formType": "image-picker",
        "title": "Photo",
        "description": "A room picture, or a photo of your own.",
        "presets": {
          "living": {
            "label": "Living room",
            "thumb": "data:image/webp;base64,"
          },
          "bedroom": {
            "label": "Bedroom",
            "thumb": "data:image/webp;base64,"
          },
          "kitchen": {
            "label": "Kitchen",
            "thumb": "data:image/webp;base64,"
          },
          "dining": {
            "label": "Dining room",
            "thumb": "data:image/webp;base64,"
          },
          "bathroom": {
            "label": "Bathroom",
            "thumb": "data:image/webp;base64,"
          },
          "office": {
            "label": "Office",
            "thumb": "data:image/webp;base64,"
          },
          "hallway": {
            "label": "Hallway",
            "thumb": "data:image/webp;base64,"
          },
          "kids": {
            "label": "Kids room",
            "thumb": "data:image/webp;base64,"
          },
          "garage": {
            "label": "Garage",
            "thumb": "data:image/webp;base64,"
          },
          "garden": {
            "label": "Garden",
            "thumb": "data:image/webp;base64,"
          }
        }
      }
    },
    "additionalProperties": false
  },
  "defaultConfig": {},
  "examples": [
    {
      "label": "Living Room",
      "size": {
        "w": 3,
        "h": 3
      },
      "config": {
        "areaId": "living_room",
        "title": "Living Room",
        "image": "preset:living"
      }
    },
    {
      "label": "Bedroom",
      "size": {
        "w": 3,
        "h": 3
      },
      "config": {
        "areaId": "bedroom",
        "image": "preset:bedroom"
      }
    },
    {
      "label": "Kitchen",
      "size": {
        "w": 3,
        "h": 3
      },
      "config": {
        "areaId": "kitchen",
        "image": "preset:kitchen"
      }
    },
    {
      "label": "Entry",
      "size": {
        "w": 3,
        "h": 3
      },
      "config": {
        "areaId": "entry",
        "image": "preset:hallway"
      }
    },
    {
      "label": "Garage",
      "size": {
        "w": 3,
        "h": 3
      },
      "config": {
        "areaId": "garage",
        "image": "preset:garage"
      }
    }
  ],
  "configVersion": 1
}
