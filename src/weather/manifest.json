{
  "name": "Weather",
  "description": "The sky outside, the hours and days ahead",
  "icon": "mdi:weather-partly-cloudy",
  "minSize": {
    "w": 2,
    "h": 1
  },
  "maxSize": {
    "w": 12,
    "h": 8
  },
  "sdkVersion": "^1.17.0",
  "version": "0.9.0",
  "defaultSize": {
    "w": 4,
    "h": 3
  },
  "capabilities": [
    {
      "domain": "weather",
      "access": "read"
    },
    {
      "domain": "sun",
      "access": "read"
    }
  ],
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "title": {
        "title": "Title",
        "description": "Optional display name override",
        "type": "string"
      },
      "entityIds": {
        "default": [],
        "domain": "weather",
        "title": "Entities",
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "showForecast": {
        "default": true,
        "title": "Show Forecast",
        "type": "boolean"
      }
    },
    "required": [
      "entityIds",
      "showForecast"
    ],
    "additionalProperties": false
  },
  "defaultConfig": {
    "entityIds": [],
    "showForecast": true
  },
  "examples": [
    {
      "label": "Partly cloudy",
      "size": {
        "w": 4,
        "h": 3
      },
      "config": {
        "entityIds": [
          "weather.demo_partly_cloudy"
        ],
        "showForecast": true
      }
    },
    {
      "label": "Centerpiece",
      "size": {
        "w": 8,
        "h": 5
      },
      "config": {
        "entityIds": [
          "weather.demo_rainy"
        ],
        "showForecast": true
      }
    },
    {
      "label": "Snow",
      "size": {
        "w": 4,
        "h": 4
      },
      "config": {
        "entityIds": [
          "weather.demo_snowy"
        ],
        "showForecast": true
      }
    },
    {
      "label": "Strip",
      "size": {
        "w": 6,
        "h": 1
      },
      "config": {
        "entityIds": [
          "weather.demo_sunny"
        ],
        "showForecast": true
      }
    }
  ]
}
