{
  "name": "Light",
  "description": "Light control with brightness, color, and temperature",
  "icon": "mdi:lightbulb",
  "minSize": {
    "w": 1,
    "h": 1
  },
  "maxSize": {
    "w": 8,
    "h": 8
  },
  "sdkVersion": "^1.17.0",
  "version": "0.9.0",
  "defaultSize": {
    "w": 2,
    "h": 2
  },
  "capabilities": [
    {
      "domain": "light",
      "access": "control"
    }
  ],
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "title": {
        "title": "Title",
        "description": "Optional display name override",
        "type": "string"
      },
      "entityIds": {
        "default": [],
        "domain": "light",
        "title": "Entities",
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "lamp": {
        "default": "table",
        "title": "Lamp picture",
        "labels": {
          "table": "Table lamp",
          "floor": "Floor lamp",
          "pendant": "Pendant",
          "desk": "Desk lamp",
          "mushroom": "Mushroom lamp",
          "ceiling": "Ceiling light",
          "sconce": "Wall light",
          "bulb": "Bare bulb"
        },
        "icons": {
          "table": "mdi:lamp",
          "floor": "mdi:floor-lamp",
          "pendant": "mdi:ceiling-light",
          "desk": "mdi:desk-lamp",
          "mushroom": "mdi:mushroom-outline",
          "ceiling": "mdi:ceiling-light-flat",
          "sconce": "mdi:wall-sconce-round",
          "bulb": "mdi:lightbulb-filament"
        },
        "type": "string",
        "enum": [
          "table",
          "floor",
          "pendant",
          "desk",
          "mushroom",
          "ceiling",
          "sconce",
          "bulb"
        ]
      }
    },
    "required": [
      "entityIds",
      "lamp"
    ],
    "additionalProperties": false
  },
  "defaultConfig": {
    "entityIds": [],
    "lamp": "table"
  },
  "examples": [
    {
      "label": "Single light",
      "size": {
        "w": 2,
        "h": 2
      },
      "config": {
        "title": "Reading Lamp",
        "entityIds": [
          "light.bedroom_ceiling"
        ],
        "lamp": "desk"
      }
    },
    {
      "label": "Room group",
      "size": {
        "w": 3,
        "h": 2
      },
      "config": {
        "title": "Living Room",
        "entityIds": [
          "light.living_room_main",
          "light.kitchen_counter",
          "light.hallway"
        ],
        "lamp": "floor"
      }
    },
    {
      "label": "Color",
      "size": {
        "w": 2,
        "h": 2
      },
      "config": {
        "title": "Studio",
        "entityIds": [
          "light.studio_rgb"
        ],
        "lamp": "bulb"
      }
    },
    {
      "label": "Colorful group",
      "size": {
        "w": 3,
        "h": 2
      },
      "config": {
        "title": "Party Mode",
        "entityIds": [
          "light.studio_rgb",
          "light.desk_rgb",
          "light.hallway"
        ],
        "lamp": "mushroom"
      }
    },
    {
      "label": "Off",
      "size": {
        "w": 2,
        "h": 2
      },
      "config": {
        "title": "Kitchen",
        "entityIds": [
          "light.kitchen_counter"
        ],
        "lamp": "pendant"
      }
    }
  ],
  "configVersion": 1
}
