{
  "name": "Electricity Grid",
  "description": "Is now a good time to use power? Grid carbon intensity and price at a glance",
  "icon": "mdi:transmission-tower",
  "minSize": {
    "w": 2,
    "h": 1
  },
  "maxSize": {
    "w": 3,
    "h": 3
  },
  "sdkVersion": "^1.14.1",
  "version": "0.1.0",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "title": {
        "title": "Title",
        "description": "Optional display name override",
        "type": "string"
      },
      "co2IntensityEntity": {
        "default": [],
        "domain": "sensor",
        "title": "CO2 intensity sensor",
        "description": "From the Electricity Maps integration, e.g. sensor.electricity_maps_co2_intensity (g/kWh).",
        "singleSelect": true,
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "fossilFuelEntity": {
        "default": [],
        "domain": "sensor",
        "title": "Fossil fuel percentage sensor",
        "description": "From the Electricity Maps integration, e.g. sensor.electricity_maps_fossil_fuel_percentage.",
        "singleSelect": true,
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "priceEntity": {
        "default": [],
        "domain": "sensor",
        "title": "Electricity price sensor",
        "description": "Optional. A current-price sensor (Nordpool, Tibber, ...).",
        "singleSelect": true,
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "cheapBelow": {
        "title": "Cheap below",
        "description": "Optional. Prices under this count as cheap, in the price sensor's own unit. Needs the price sensor.",
        "type": "number"
      }
    },
    "required": [
      "co2IntensityEntity",
      "fossilFuelEntity",
      "priceEntity"
    ],
    "additionalProperties": false
  },
  "defaultConfig": {
    "co2IntensityEntity": [],
    "fossilFuelEntity": [],
    "priceEntity": []
  },
  "examples": [
    {
      "label": "Full view",
      "size": {
        "w": 3,
        "h": 3
      },
      "config": {
        "title": "Electricity Grid",
        "co2IntensityEntity": [
          "sensor.electricity_maps_co2_intensity"
        ],
        "fossilFuelEntity": [
          "sensor.electricity_maps_fossil_fuel_percentage"
        ],
        "priceEntity": [
          "sensor.nordpool_current_price"
        ],
        "cheapBelow": 0.2
      }
    },
    {
      "label": "Carbon and price",
      "size": {
        "w": 2,
        "h": 2
      },
      "config": {
        "title": "Electricity Grid",
        "co2IntensityEntity": [
          "sensor.electricity_maps_co2_intensity"
        ],
        "fossilFuelEntity": [
          "sensor.electricity_maps_fossil_fuel_percentage"
        ],
        "priceEntity": [
          "sensor.nordpool_current_price"
        ],
        "cheapBelow": 0.2
      }
    },
    {
      "label": "Carbon only",
      "size": {
        "w": 2,
        "h": 1
      },
      "config": {
        "title": "Electricity Grid",
        "co2IntensityEntity": [
          "sensor.electricity_maps_co2_intensity"
        ],
        "fossilFuelEntity": [
          "sensor.electricity_maps_fossil_fuel_percentage"
        ],
        "priceEntity": []
      }
    }
  ],
  "defaultSize": {
    "w": 2,
    "h": 2
  },
  "capabilities": [
    {
      "domain": "sensor",
      "access": "read"
    }
  ]
}
