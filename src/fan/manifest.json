{
  "name": "Fan",
  "description": "Fan control with speed, presets, oscillation, and direction",
  "icon": "mdi:fan",
  "minSize": {
    "w": 1,
    "h": 1
  },
  "maxSize": {
    "w": 4,
    "h": 4
  },
  "sdkVersion": "^1.12.0",
  "version": "0.2.0",
  "defaultSize": {
    "w": 2,
    "h": 2
  },
  "capabilities": [
    {
      "domain": "fan",
      "access": "control"
    }
  ],
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "title": {
        "title": "Title",
        "description": "Optional display name override",
        "type": "string"
      },
      "entityIds": {
        "default": [],
        "domain": "fan",
        "title": "Entities",
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "required": [
      "entityIds"
    ],
    "additionalProperties": false
  },
  "defaultConfig": {
    "entityIds": []
  },
  "examples": [
    {
      "label": "Ceiling fan",
      "size": {
        "w": 2,
        "h": 2
      },
      "config": {
        "entityIds": [
          "fan.bedroom_ceiling"
        ],
        "title": "Bedroom Fan"
      }
    },
    {
      "label": "Purifier",
      "size": {
        "w": 2,
        "h": 2
      },
      "config": {
        "entityIds": [
          "fan.air_purifier"
        ]
      }
    }
  ]
}
