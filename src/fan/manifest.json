{
  "name": "Fan",
  "description": "Fan control with speed, presets, oscillation, and direction",
  "icon": "mdi:fan",
  "minSize": {
    "w": 1,
    "h": 1
  },
  "maxSize": {
    "w": 8,
    "h": 8
  },
  "sdkVersion": "^1.17.0",
  "version": "0.3.0",
  "defaultSize": {
    "w": 2,
    "h": 2
  },
  "capabilities": [
    {
      "domain": "fan",
      "access": "control"
    }
  ],
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "title": {
        "title": "Title",
        "description": "Optional display name override",
        "type": "string"
      },
      "entityIds": {
        "default": [],
        "domain": "fan",
        "title": "Entities",
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "art": {
        "default": "pedestal",
        "title": "Fan picture",
        "labels": {
          "pedestal": "Standing fan",
          "purifier": "Air purifier"
        },
        "icons": {
          "pedestal": "mdi:fan",
          "purifier": "mdi:air-purifier"
        },
        "type": "string",
        "enum": [
          "pedestal",
          "purifier"
        ]
      }
    },
    "required": [
      "entityIds",
      "art"
    ],
    "additionalProperties": false
  },
  "defaultConfig": {
    "entityIds": [],
    "art": "pedestal"
  },
  "examples": [
    {
      "label": "Ceiling fan",
      "size": {
        "w": 2,
        "h": 2
      },
      "config": {
        "entityIds": [
          "fan.bedroom_ceiling"
        ],
        "title": "Bedroom Fan",
        "art": "pedestal"
      }
    },
    {
      "label": "Purifier",
      "size": {
        "w": 2,
        "h": 2
      },
      "config": {
        "entityIds": [
          "fan.air_purifier"
        ],
        "art": "purifier"
      }
    },
    {
      "label": "Fans",
      "size": {
        "w": 3,
        "h": 2
      },
      "config": {
        "entityIds": [
          "fan.bedroom_ceiling",
          "fan.air_purifier"
        ],
        "title": "Fans",
        "art": "pedestal"
      }
    },
    {
      "label": "Compact",
      "size": {
        "w": 1,
        "h": 1
      },
      "config": {
        "entityIds": [
          "fan.bedroom_ceiling"
        ],
        "title": "Bedroom Fan",
        "art": "pedestal"
      }
    },
    {
      "label": "Large purifier",
      "size": {
        "w": 4,
        "h": 4
      },
      "config": {
        "entityIds": [
          "fan.air_purifier"
        ],
        "art": "purifier"
      }
    }
  ],
  "configVersion": 1
}
