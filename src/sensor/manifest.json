{
  "name": "Sensor",
  "description": "Display sensor values with aggregation",
  "icon": "mdi:eye",
  "minSize": {
    "w": 1,
    "h": 1
  },
  "maxSize": {
    "w": 4,
    "h": 4
  },
  "sdkVersion": "^1.9.3",
  "version": "0.8.0",
  "defaultSize": {
    "w": 2,
    "h": 1
  },
  "capabilities": [
    {
      "domain": "sensor",
      "access": "read"
    }
  ],
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "title": {
        "title": "Title",
        "description": "Optional display name override",
        "type": "string"
      },
      "entityIds": {
        "default": [],
        "domain": "sensor",
        "title": "Entities",
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "aggregationType": {
        "default": "mean",
        "title": "Aggregation",
        "type": "string",
        "enum": [
          "mean",
          "min",
          "max",
          "sum",
          "median"
        ]
      }
    },
    "required": [
      "entityIds",
      "aggregationType"
    ],
    "additionalProperties": false
  },
  "defaultConfig": {
    "entityIds": [],
    "aggregationType": "mean"
  },
  "examples": [
    {
      "label": "Climate Sensors",
      "size": {
        "w": 2,
        "h": 2
      },
      "config": {
        "entityIds": [
          "sensor.temperature_living",
          "sensor.humidity_living",
          "sensor.temperature_outdoor"
        ],
        "title": "Climate Sensors",
        "aggregationType": "mean"
      }
    }
  ]
}
