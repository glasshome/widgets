{
  "name": "Header",
  "description": "Your dashboard's name, with chips for what is on, an entity to watch, or a scene to run",
  "icon": "mdi:format-header-1",
  "minSize": {
    "w": 2,
    "h": 1
  },
  "maxSize": {
    "w": 12,
    "h": 1
  },
  "defaultSize": {
    "w": 6,
    "h": 1
  },
  "sdkVersion": "^1.15.0",
  "capabilities": [
    {
      "domain": "light",
      "access": "control"
    },
    {
      "domain": "lock",
      "access": "control"
    },
    {
      "domain": "cover",
      "access": "control"
    },
    {
      "domain": "switch",
      "access": "control"
    },
    {
      "domain": "fan",
      "access": "control"
    },
    {
      "domain": "scene",
      "access": "control"
    },
    {
      "domain": "script",
      "access": "control"
    },
    {
      "domain": "sensor",
      "access": "read"
    }
  ],
  "version": "0.1.0",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "title": {
        "title": "Title",
        "description": "Empty shows the dashboard's name",
        "type": "string"
      },
      "icon": {
        "type": "string",
        "formType": "icon-picker",
        "title": "Icon",
        "description": "Empty shows the dashboard's icon"
      },
      "greeting": {
        "default": true,
        "title": "Greeting",
        "description": "A line under the name that follows the time of day",
        "type": "boolean"
      },
      "where": {
        "default": {
          "scope": "dashboard"
        },
        "formType": "variants",
        "discriminator": "scope",
        "title": "Where",
        "description": "Which entities the chips count",
        "labels": {
          "dashboard": "This dashboard's area",
          "home": "The whole home",
          "area": "Somewhere specific"
        },
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "scope": {
                "type": "string",
                "const": "dashboard"
              }
            },
            "required": [
              "scope"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "scope": {
                "type": "string",
                "const": "home"
              }
            },
            "required": [
              "scope"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "areaId": {
                "formType": "area-picker",
                "title": "Which area",
                "type": "string"
              },
              "scope": {
                "type": "string",
                "const": "area"
              }
            },
            "required": [
              "scope"
            ],
            "additionalProperties": false
          }
        ]
      },
      "chips": {
        "default": [],
        "formType": "list",
        "title": "Chips",
        "description": "Right to left. A chip with nothing to report hides itself.",
        "maxItems": 6,
        "type": "array",
        "items": {
          "default": {
            "only": [],
            "shows": "lights"
          },
          "formType": "variants",
          "discriminator": "shows",
          "title": "Kind",
          "labels": {
            "lights": "Lights",
            "locks": "Locks",
            "covers": "Covers",
            "switches": "Switches",
            "fans": "Fans",
            "value": "Value",
            "action": "Action"
          },
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "only": {
                  "default": [],
                  "domain": "light",
                  "title": "Only these",
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "shows": {
                  "type": "string",
                  "const": "lights"
                }
              },
              "required": [
                "only",
                "shows"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "only": {
                  "default": [],
                  "domain": "lock",
                  "title": "Only these",
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "shows": {
                  "type": "string",
                  "const": "locks"
                }
              },
              "required": [
                "only",
                "shows"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "only": {
                  "default": [],
                  "domain": "cover",
                  "title": "Only these",
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "shows": {
                  "type": "string",
                  "const": "covers"
                }
              },
              "required": [
                "only",
                "shows"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "only": {
                  "default": [],
                  "domain": "switch",
                  "title": "Only these",
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "shows": {
                  "type": "string",
                  "const": "switches"
                }
              },
              "required": [
                "only",
                "shows"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "only": {
                  "default": [],
                  "domain": "fan",
                  "title": "Only these",
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "shows": {
                  "type": "string",
                  "const": "fans"
                }
              },
              "required": [
                "only",
                "shows"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "entityId": {
                  "default": [],
                  "domain": "sensor",
                  "title": "Which entity",
                  "singleSelect": true,
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "shows": {
                  "type": "string",
                  "const": "value"
                }
              },
              "required": [
                "entityId",
                "shows"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "entityId": {
                  "default": [],
                  "domain": "scene",
                  "title": "What to run",
                  "singleSelect": true,
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "shows": {
                  "type": "string",
                  "const": "action"
                }
              },
              "required": [
                "entityId",
                "shows"
              ],
              "additionalProperties": false
            }
          ]
        }
      }
    },
    "required": [
      "greeting",
      "where",
      "chips"
    ],
    "additionalProperties": false
  },
  "defaultConfig": {
    "greeting": true,
    "where": {
      "scope": "dashboard"
    },
    "chips": []
  },
  "examples": [
    {
      "label": "Dashboard header",
      "size": {
        "w": 6,
        "h": 1
      },
      "config": {
        "greeting": true,
        "where": {
          "scope": "dashboard"
        },
        "chips": [
          {
            "shows": "lights",
            "only": []
          },
          {
            "shows": "locks",
            "only": []
          }
        ]
      }
    },
    {
      "label": "Section title",
      "size": {
        "w": 3,
        "h": 1
      },
      "config": {
        "title": "Upstairs",
        "icon": "mdi:stairs-up",
        "greeting": false,
        "where": {
          "scope": "dashboard"
        },
        "chips": []
      }
    }
  ]
}
