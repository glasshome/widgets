{
  "name": "Picture Frame",
  "description": "Show one of your own photos on the dashboard",
  "minSize": {
    "w": 1,
    "h": 1
  },
  "maxSize": {
    "w": 8,
    "h": 6
  },
  "defaultSize": {
    "w": 2,
    "h": 2
  },
  "sdkVersion": "^1.11.2",
  "capabilities": [],
  "version": "0.1.0",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "image": {
        "type": "string",
        "formType": "image-picker",
        "title": "Picture"
      },
      "caption": {
        "title": "Caption",
        "type": "string"
      },
      "fit": {
        "default": "cover",
        "title": "Fit",
        "type": "string",
        "enum": [
          "cover",
          "contain"
        ]
      }
    },
    "required": [
      "fit"
    ],
    "additionalProperties": false
  },
  "defaultConfig": {
    "fit": "cover"
  },
  "examples": [
    {
      "label": "Family photo",
      "size": {
        "w": 3,
        "h": 2
      },
      "config": {
        "fit": "cover",
        "caption": "Summer at the lake"
      }
    }
  ],
  "icon": "mdi:image-frame"
}
