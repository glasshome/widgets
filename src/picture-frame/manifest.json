{
  "name": "Picture Frame",
  "description": "Your own photos on the dashboard, one at a time or as a slideshow",
  "minSize": {
    "w": 1,
    "h": 1
  },
  "maxSize": {
    "w": 12,
    "h": 12
  },
  "defaultSize": {
    "w": 2,
    "h": 2
  },
  "sdkVersion": "^1.16.0",
  "capabilities": [],
  "version": "0.1.0",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "pictures": {
        "default": [],
        "formType": "list",
        "title": "Pictures",
        "addLabel": "Add picture",
        "maxItems": 24,
        "type": "array",
        "items": {
          "default": {},
          "title": "Picture",
          "type": "object",
          "properties": {
            "image": {
              "type": "string",
              "formType": "image-picker",
              "title": "Picture",
              "presets": {
                "coast": {
                  "label": "Coast",
                  "thumb": "data:image/webp;base64,"
                },
                "dog": {
                  "label": "Dog",
                  "thumb": "data:image/webp;base64,"
                },
                "forest": {
                  "label": "Forest",
                  "thumb": "data:image/webp;base64,"
                },
                "meadow": {
                  "label": "Meadow",
                  "thumb": "data:image/webp;base64,"
                }
              }
            }
          },
          "additionalProperties": false
        }
      },
      "fit": {
        "default": "cover",
        "title": "Fit",
        "type": "string",
        "enum": [
          "cover",
          "contain"
        ]
      },
      "interval": {
        "default": "30s",
        "title": "Change every",
        "description": "Off keeps one picture up until you swipe to the next.",
        "type": "string",
        "enum": [
          "off",
          "10s",
          "30s",
          "1m",
          "5m"
        ]
      }
    },
    "required": [
      "pictures",
      "fit",
      "interval"
    ],
    "additionalProperties": false
  },
  "defaultConfig": {
    "pictures": [],
    "fit": "cover",
    "interval": "30s"
  },
  "icon": "mdi:image-frame",
  "configVersion": 2,
  "examples": [
    {
      "label": "Sample photos",
      "size": {
        "w": 2,
        "h": 2
      },
      "config": {
        "pictures": [],
        "fit": "cover",
        "interval": "30s"
      }
    },
    {
      "label": "Your photo",
      "size": {
        "w": 3,
        "h": 3
      },
      "config": {
        "pictures": [
          {
            "image": "preset:dog"
          }
        ],
        "fit": "cover",
        "interval": "30s"
      }
    },
    {
      "label": "Wide",
      "size": {
        "w": 4,
        "h": 2
      },
      "config": {
        "pictures": [
          {
            "image": "preset:coast"
          },
          {
            "image": "preset:meadow"
          }
        ],
        "fit": "cover",
        "interval": "30s"
      }
    },
    {
      "label": "Portrait, whole picture",
      "size": {
        "w": 3,
        "h": 3
      },
      "config": {
        "pictures": [
          {
            "image": "preset:forest"
          }
        ],
        "fit": "contain",
        "interval": "30s"
      }
    },
    {
      "label": "Tall",
      "size": {
        "w": 2,
        "h": 4
      },
      "config": {
        "pictures": [
          {
            "image": "preset:forest"
          }
        ],
        "fit": "cover",
        "interval": "30s"
      }
    },
    {
      "label": "Large",
      "size": {
        "w": 4,
        "h": 4
      },
      "config": {
        "pictures": [
          {
            "image": "preset:meadow"
          },
          {
            "image": "preset:dog"
          }
        ],
        "fit": "cover",
        "interval": "30s"
      }
    },
    {
      "label": "Small",
      "size": {
        "w": 1,
        "h": 1
      },
      "config": {
        "pictures": [
          {
            "image": "preset:dog"
          }
        ],
        "fit": "cover",
        "interval": "30s"
      }
    }
  ]
}
