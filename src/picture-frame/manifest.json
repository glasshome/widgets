{
  "name": "Picture Frame",
  "description": "Show your own photos on the dashboard, one at a time",
  "minSize": {
    "w": 1,
    "h": 1
  },
  "maxSize": {
    "w": 8,
    "h": 6
  },
  "defaultSize": {
    "w": 2,
    "h": 2
  },
  "sdkVersion": "^1.11.2",
  "capabilities": [],
  "version": "0.1.0",
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "pictures": {
        "default": [],
        "formType": "list",
        "title": "Pictures",
        "addLabel": "Add picture",
        "maxItems": 24,
        "type": "array",
        "items": {
          "default": {},
          "title": "Picture",
          "type": "object",
          "properties": {
            "image": {
              "type": "string",
              "formType": "image-picker",
              "title": "Picture"
            }
          },
          "additionalProperties": false
        }
      },
      "fit": {
        "default": "cover",
        "title": "Fit",
        "type": "string",
        "enum": [
          "cover",
          "contain"
        ]
      },
      "interval": {
        "default": "30s",
        "title": "Change every",
        "description": "Off keeps one picture up until you swipe to the next.",
        "type": "string",
        "enum": [
          "off",
          "10s",
          "30s",
          "1m",
          "5m"
        ]
      }
    },
    "required": [
      "pictures",
      "fit",
      "interval"
    ],
    "additionalProperties": false
  },
  "defaultConfig": {
    "pictures": [],
    "fit": "cover",
    "interval": "30s"
  },
  "examples": [
    {
      "label": "Family photos",
      "size": {
        "w": 3,
        "h": 2
      },
      "config": {
        "pictures": [],
        "fit": "cover",
        "interval": "30s"
      }
    }
  ],
  "icon": "mdi:image-frame",
  "configVersion": 1
}
