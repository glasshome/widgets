{
  "name": "Scene",
  "description": "Activate a scene",
  "icon": "mdi:palette",
  "minSize": {
    "w": 1,
    "h": 1
  },
  "maxSize": {
    "w": 8,
    "h": 8
  },
  "sdkVersion": "^1.17.1",
  "version": "1.0.1",
  "defaultSize": {
    "w": 1,
    "h": 1
  },
  "capabilities": [
    {
      "domain": "scene",
      "access": "control"
    }
  ],
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "title": {
        "title": "Title",
        "description": "Optional display name override",
        "type": "string"
      },
      "entityIds": {
        "default": [],
        "domain": "scene",
        "title": "Entities",
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "required": [
      "entityIds"
    ],
    "additionalProperties": false
  },
  "defaultConfig": {
    "entityIds": []
  },
  "examples": [
    {
      "label": "One scene",
      "size": {
        "w": 1,
        "h": 1
      },
      "config": {
        "entityIds": [
          "scene.movie_night"
        ],
        "title": "Movie Night"
      }
    },
    {
      "label": "Scenes",
      "size": {
        "w": 2,
        "h": 2
      },
      "config": {
        "entityIds": [
          "scene.movie_night",
          "scene.good_morning"
        ],
        "title": "Scenes"
      }
    },
    {
      "label": "Wide",
      "size": {
        "w": 4,
        "h": 1
      },
      "config": {
        "entityIds": [
          "scene.movie_night",
          "scene.good_morning"
        ],
        "title": "Scenes"
      }
    }
  ]
}
