{
  "name": "Batteries",
  "description": "Auto-discover and monitor battery levels across all devices",
  "icon": "mdi:battery",
  "minSize": {
    "w": 2,
    "h": 1
  },
  "maxSize": {
    "w": 4,
    "h": 4
  },
  "sdkVersion": "^1.10.1",
  "version": "0.7.0",
  "defaultSize": {
    "w": 2,
    "h": 2
  },
  "capabilities": [
    {
      "domain": "sensor",
      "access": "read"
    }
  ],
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "title": {
        "title": "Title",
        "description": "Optional display name override",
        "type": "string"
      },
      "threshold": {
        "default": 20,
        "title": "Low Battery Threshold (%)",
        "type": "number",
        "minimum": 0,
        "maximum": 100
      },
      "whitelist": {
        "default": [],
        "title": "Whitelist (include only these)",
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "blacklist": {
        "default": [],
        "title": "Blacklist (exclude these)",
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "required": [
      "threshold",
      "whitelist",
      "blacklist"
    ],
    "additionalProperties": false
  },
  "defaultConfig": {
    "threshold": 20,
    "whitelist": [],
    "blacklist": []
  },
  "examples": [
    {
      "label": "Batteries",
      "size": {
        "w": 2,
        "h": 3
      },
      "config": {
        "title": "Batteries",
        "threshold": 20,
        "whitelist": [],
        "blacklist": []
      }
    }
  ]
}
