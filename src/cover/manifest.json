{
  "name": "Cover",
  "description": "Control covers, blinds, and shutters",
  "icon": "mdi:window-shutter",
  "minSize": {
    "w": 1,
    "h": 1
  },
  "maxSize": {
    "w": 4,
    "h": 4
  },
  "sdkVersion": "^1.10.3",
  "version": "0.8.0",
  "defaultSize": {
    "w": 2,
    "h": 2
  },
  "capabilities": [
    {
      "domain": "cover",
      "access": "control"
    }
  ],
  "schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "title": {
        "title": "Title",
        "description": "Optional display name override",
        "type": "string"
      },
      "entityIds": {
        "default": [],
        "domain": "cover",
        "title": "Entities",
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "required": [
      "entityIds"
    ],
    "additionalProperties": false
  },
  "defaultConfig": {
    "entityIds": []
  },
  "examples": [
    {
      "label": "Blinds",
      "size": {
        "w": 3,
        "h": 2
      },
      "config": {
        "entityIds": [
          "cover.living_room_blinds",
          "cover.bedroom_curtains"
        ],
        "title": "Blinds"
      }
    }
  ]
}
